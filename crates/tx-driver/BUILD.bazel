load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//:lints/cargo_lint_sources.bzl", "cargo_lint_sources")

package(default_visibility = ["//visibility:public"])

cargo_lint_sources()

exports_files(["Cargo.toml"])

rust_library(
    name = "tx-driver",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "default",
        "nockapp-driver",
    ],
    edition = "2021",
    deps = [
        "//crates/nockapp",
        "//crates/nockapp-grpc",
        "//crates/nockapp-grpc-proto",
        "//crates/nockchain-math",
        "//crates/nockchain-types",
        "//crates/nockvm/rust/nockvm",
        "//crates/nockvm/rust/nockvm_macros",
        "//crates/noun-serde",
        "//crates/wallet-tx-builder",
    ] + all_crate_deps(),
)

rust_test(
    name = "tx_driver_unit_tests",
    size = "small",
    crate = ":tx-driver",
    # `testing` is on here but not in the library above: the in-memory
    # ChainSource/Signer mocks are compiled for tests via `cfg(test)` anyway,
    # and the feature exists so downstream suites can reach them.
    crate_features = [
        "default",
        "nockapp-driver",
        "testing",
    ],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
